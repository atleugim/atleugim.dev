---
import type { Post } from "~/lib/posts";
import { formatDate } from "~/lib/utils";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li>
  <a
    href={`/blog/${post.id}`}
    class="group flex flex-col gap-0.5 py-1 no-underline hover:font-normal"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h4
        class="decoration-foreground/30 text-sm font-bold underline-offset-4 group-hover:underline sm:text-base"
      >
        {post.data.title}
      </h4>
      <time
        datetime={post.data.publishedAt.toISOString()}
        class="text-dimmed shrink-0 font-mono text-xs"
      >
        {formatDate(post.data.publishedAt)}
      </time>
    </div>
    <p class="text-dimmed text-sm">{post.data.description}</p>
  </a>
</li>
