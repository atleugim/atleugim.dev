---
import { EMAIL_URL } from "~/lib/const";

import P from "../shared/headings/p.astro";
import Section from "../shared/section.astro";
---

<Section class="my-8 items-center border-none">
  <P class="text-center">
    Feel free to ask a question or if you just want to say hi
  </P>
  <a
    href={EMAIL_URL}
    rel="noopener noreferrer"
    class="bg-primary rounded-full px-8 py-2 font-medium text-white duration-200 hover:contrast-125"
  >
    Say Hello 👋
  </a>
</Section>
