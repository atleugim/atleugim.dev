---
import { Image } from "astro:assets";

import ActiveIndicator from "~/components/shared/active-indicator.astro";
import H4 from "~/components/shared/headings/h4.astro";

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<li class="flex items-start gap-4">
  <div
    class="flex aspect-square shrink-0 items-center justify-center rounded-full p-2"
    style={{
      backgroundColor: job.color,
    }}
  >
    <Image
      src={job.logo}
      alt={job.company}
      loading="eager"
      width={25}
      height={25}
    />
  </div>
  <div class="flex flex-col">
    <div class="flex items-center gap-2.5">
      <H4>{job.company}</H4>
      {job.current && <ActiveIndicator />}
    </div>
    <span class="text-dimmed text-sm font-medium">
      {job.role} • {job.date}
    </span>
    <ul class="mt-2 grid gap-1.5">
      {
        job.description.map((description) => (
          <li class="text-sm"> • {description}</li>
        ))
      }
    </ul>
  </div>
</li>
