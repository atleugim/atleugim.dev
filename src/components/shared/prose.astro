---
const { class: className, ...rest } = Astro.props;
---

<div class:list={["prose", className]} {...rest}>
  <slot />
</div>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]')
    .forEach((link) => {
      if (link.hostname === window.location.hostname) return;

      link.target = "_blank";
      link.rel = "noopener noreferrer";
    });
</script>

<style is:global>
  .prose {
    --prose-gap: 1.25rem;

    display: flex;
    flex-direction: column;
    gap: var(--prose-gap);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-dimmed);
    overflow-wrap: break-word;
  }

  .prose :is(h2, h3, h4) {
    color: var(--color-foreground);
    font-weight: 700;
    line-height: 1.3;
    scroll-margin-top: 5rem;
    margin-top: 1.25rem;
  }

  .prose :is(h2, h3, h4):first-child {
    margin-top: 0;
  }

  .prose h2 {
    font-size: 1.25rem;
  }

  .prose h3 {
    font-size: 1.125rem;
  }

  .prose h4 {
    font-size: 1rem;
  }

  .prose strong {
    color: var(--color-foreground);
    font-weight: 700;
    text-decoration: none;
  }

  .prose strong:hover {
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
  }

  .prose :is(ul, ol) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.5rem;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li::marker {
    color: color-mix(in oklab, var(--color-dimmed) 60%, transparent);
  }

  .prose blockquote {
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
    font-style: italic;
  }

  .prose hr {
    border: none;
    border-top: 1px solid
      color-mix(in oklab, var(--color-foreground) 10%, transparent);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }

  /* Inline code */
  .prose :not(pre) > code {
    background-color: color-mix(
      in oklab,
      var(--color-foreground) 8%,
      transparent
    );
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-foreground);
  }

  /* Code blocks */
  .prose pre {
    border: 1px solid
      color-mix(in oklab, var(--color-foreground) 10%, transparent);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.7;
    tab-size: 2;
  }

  .prose pre code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* Shiki dual theme, driven by the .dark class */
  .prose pre,
  .prose pre span {
    color: var(--shiki-light);
  }

  .prose pre {
    background-color: var(--shiki-light-bg);
  }

  .dark .prose pre,
  .dark .prose pre span {
    color: var(--shiki-dark);
  }

  .dark .prose pre {
    background-color: var(--shiki-dark-bg);
  }

  /* Tables */
  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .prose :is(th, td) {
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-foreground) 10%, transparent);
    padding: 0.5rem 0.75rem;
    vertical-align: top;
  }

  .prose th {
    color: var(--color-foreground);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
