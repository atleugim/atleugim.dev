---
import {
  SITE_DESCRIPTION,
  SITE_IMAGE,
  SITE_TITLE,
  SITE_URL,
} from "~/lib/const";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  title,
  description,
  image,
  type = "website",
  publishedAt,
  updatedAt,
} = Astro.props;

const pageTitle = title ? `${title} - Miguel Vega` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const pageImage = image ?? SITE_IMAGE;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="author" content="Miguel Vega" />
  <meta name="developer" content="atleugim" />
  <meta name="title" content={pageTitle} />
  <meta name="description" content={pageDescription} />
  <meta name="category" content="Developer Portfolio" />

  <meta
    property="og:site_name"
    content="Miguel Vega - Frontend developer specialized in web and mobile development, building personal digital experiences."
  />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={pageImage} />
  <meta property="og:image:width" content="800" />
  <meta property="og:image:height" content="600" />

  {type === "article" && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )}
  {type === "article" && updatedAt && (
    <meta property="article:modified_time" content={updatedAt.toISOString()} />
  )}
  {type === "article" && (
    <meta property="article:author" content="Miguel Vega" />
  )}

  <meta name="twitter:creator" content="@atleugim" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:site" content={SITE_URL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={pageImage} />

  <meta name="robots" content="index,follow" />
  <meta
    name="googlebot"
    content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
  />

  <meta
    name="keywords"
    content="Miguel Vega, Miguel Ángel Vega Jiménez, atleugim, software engineer, software engineer Colombia, product engineer, AI-assisted development, developer tooling, ingeniero de software, ingeniero de software Colombia"
  />

  <meta name="theme-color" />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="canonical" href={canonical} />
  <link
    rel="icon"
    type="image/png"
    href="https://github.com/atleugim.png?size=32"
    sizes="32x32"
  />
  <link
    rel="icon"
    type="image/png"
    href="https://github.com/atleugim.png?size=96"
    sizes="96x96"
  />
  <link
    rel="apple-touch-icon"
    href="https://github.com/atleugim.png?size=180"
    sizes="180x180"
  />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="Miguel Vega - Writing"
    href={new URL("/rss.xml", SITE_URL).href}
  />

  <title>{pageTitle}</title>
</head>
