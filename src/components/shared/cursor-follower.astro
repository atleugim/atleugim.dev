<div
  id="cursor-follower"
  class="pointer-events-none fixed inset-0 z-0 hidden opacity-5 lg:block"
>
</div>

<script>
  const addCursorFollowerBackground = (event: MouseEvent | Event) => {
    const follower = document.getElementById("cursor-follower");

    if (follower && event instanceof MouseEvent) {
      const x = event.clientX;
      const y = event.clientY;
      follower.style.background = `radial-gradient(600px at ${x}px ${y}px, var(--color-primary), transparent 80%)`;
    }
  };

  document.addEventListener("mousemove", addCursorFollowerBackground);
  document.addEventListener("astro:after-swap", addCursorFollowerBackground);
</script>
